{
  "name": "overwatch-atlas",
  "version": "1.0.0",
  "description": "Overwatch Atlas — interactive lore timeline",
  "scripts": {
    "start": "node scripts/generate-manifest.js && node src/server.js",
    "generate": "node scripts/generate-manifest.js",
    "build:pages": "node scripts/generate-manifest.js && node scripts/prepare-github-pages.mjs",
    "dev": "node scripts/generate-manifest.js && node src/server.js",
    "content:ids": "node scripts/ensure-content-ids.mjs",
    "content:ids:check": "node scripts/ensure-content-ids.mjs --check",
    "i18n:check": "node scripts/i18n-check.mjs",
    "i18n:check:strict": "node scripts/i18n-check.mjs --strict",
    "i18n:seed": "node scripts/seed-cn-glossary.mjs",
    "i18n:seed:content": "node scripts/seed-cn-content.mjs",
    "i18n:seed:headlines": "node scripts/seed-cn-headlines.mjs",
    "sync:upstream": "node scripts/sync-upstream.mjs",
    "sync:upstream:check": "node scripts/sync-upstream.mjs --check-only",
    "launch": "node scripts/generate-manifest.js && start cmd /k \"node src/server.js\" && timeout /t 3 /nobreak >nul && start chrome.exe http://localhost:8000",
    "flags:lookup": "node scripts/build-flags-lookup.mjs"
  },
  "dependencies": {},
  "devDependencies": {}
}
